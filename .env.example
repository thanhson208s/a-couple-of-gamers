# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acog

# Redis
REDIS_URL=redis://localhost:6379

# JWT signing keys — use separate secrets, minimum 256-bit random values
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FCM_SERVICE_ACCOUNT={"type":"service_account",...}

# Error tracking
SENTRY_DSN=https://...@sentry.io/...

# Admin dashboard
ADMIN_TOKEN=change-me-admin-token

# Cloudflare R2 (CI/CD only — not needed for local dev)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Server
PORT=3000
NODE_ENV=development
