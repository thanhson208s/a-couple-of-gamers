# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acog

# Redis
REDIS_URL=redis://localhost:6379

# JWT signing keys — use separate secrets, minimum 256-bit random values
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT="{\"type\":\"service_account\",...}"

# Error tracking
SENTRY_DSN=https://...@sentry.io/...

# Admin dashboard
ADMIN_TOKEN=change-me-admin-token

# Cloudflare R2 (CI/CD only — not needed for local dev)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Cloudflare cache purge (server-side — leave empty for local dev)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
APP_BASE_URL=https://acog.gootube.online

# Cloudflare Access — admin auth (leave empty for local dev; falls back to ADMIN_TOKEN)
CF_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=

# Server
PORT=3000
NODE_ENV=development

# Dev mode — local only. NEVER set in staging or production.
DEV_MODE=true
