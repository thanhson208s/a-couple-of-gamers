# Per-environment Caddyfile is bind-mounted via docker-compose override.
# See docker-compose.prod-app.yml and docker-compose.staging.yml.
#
# Production:  acog.gootube.online → app:3000
# Staging:     acoq.gootube.online → app:3000
#
# Caddy handles TLS (automatic Let's Encrypt), WebSocket Upgrade headers,
# and HTTP→HTTPS redirect automatically — no manual cert management.
