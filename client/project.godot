; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="A Couple of Gamers"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

Firebase="*uid://cvb26atjckwlq"

[debug]

settings/gdscript/always_track_call_stacks=true

[editor_plugins]

enabled=PackedStringArray("res://addons/DeeplinkPlugin/plugin.cfg", "res://addons/InappReviewPlugin/plugin.cfg", "res://addons/admob/plugin.cfg", "res://addons/godot-firebase/plugin.cfg", "res://addons/godotx_firebase/plugin.cfg", "res://addons/godotx_revenue_cat/plugin.cfg", "res://addons/http-sse-client/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
